# Plantilla para el servidor público. Copiar como .env en el servidor y completar los valores.
# Nunca subir el .env local ni versionar el .env del servidor. Generar APP_KEY una sola vez con
# `php artisan key:generate` y conservarla: cifra las claves de dos pasos y los respaldos.

APP_NAME="Medicina Respiratoria"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# Dominio HTTPS definitivo, sin barra final. Solo se aceptan peticiones a este hostname exacto;
# redirigir www u otros alias hacia este dominio desde el hosting.
APP_URL=https://medicinarespiratoriadrjesus.com
# Mantener en false hasta la revisión final; en true permite indexación y publica el sitemap.
SITE_INDEXABLE=false

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# Base y usuario exclusivos creados en cPanel (el prefijo de cuenta forma parte del nombre).
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

# Caché persistente: requerida por los límites de intentos de acceso.
CACHE_STORE=database

# SMTP real del dominio (cuenta de correo creada en cPanel). Necesario para recuperar contraseñas
# y enlaces privados de cuentas. Probar con una cuenta del equipo antes del lanzamiento.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.medicinarespiratoriadrjesus.com
MAIL_PORT=465
MAIL_USERNAME=sistema@medicinarespiratoriadrjesus.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=sistema@medicinarespiratoriadrjesus.com
MAIL_FROM_NAME="${APP_NAME}"

# Respaldos cifrados: activar solo con el cron del servidor configurado y un destino externo definido.
BACKUP_ENABLED=false
BACKUP_TIME=03:15
BACKUP_RETENTION_DAYS=14

VITE_APP_NAME="${APP_NAME}"
