# Reglas para public_html en cPanel/Apache. Reemplaza al .htaccess estándar de Laravel.
# Mantener este archivo junto al index.php adaptado; no colocar la aplicación dentro de public_html.

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Instalar AutoSSL antes de abrir el sitio. Destino fijo, sin confiar en Host.
    # Permitir la validación HTTP del certificado antes de redirigir.
    RewriteRule ^\.well-known/acme-challenge/ - [L]
    RewriteCond %{HTTPS} !=on [OR]
    RewriteCond %{HTTP_HOST} !^medicinarespiratoriadrjesus\.com$ [NC]
    RewriteRule ^ https://medicinarespiratoriadrjesus.com%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Nunca servir archivos ocultos ni de configuración que pudieran quedar en la raíz web.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
<FilesMatch "\.(env|log|sql|zip|bak|md|json|lock|sh|ps1)$">
    Require all denied
</FilesMatch>

# Los recursos compilados llevan hash en el nombre: pueden cachearse de forma prolongada.
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(webp|png|jpg|jpeg|ico|svg)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

# Límites de carga para la biblioteca de imágenes. Si el hosting usa PHP-FPM, estos valores se
# ignoran aquí y deben fijarse en "MultiPHP INI Editor" de cPanel (upload_max_filesize=8M,
# post_max_size=12M, memory_limit=256M, max_execution_time=120).
# php_value upload_max_filesize 8M
# php_value post_max_size 12M
